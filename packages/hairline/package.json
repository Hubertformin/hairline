{
  "name": "@hairline/ds",
  "version": "0.1.0",
  "description": "Hairline — a calm money design system. Monochrome ink on paper, mono uppercase labels, tabular figures, generous space, colour reserved for data.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "skill",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./native": {
      "types": "./dist/native/index.d.ts",
      "default": "./dist/native/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "default": "./dist/tokens/index.js"
    },
    "./hairline.css": "./dist/hairline.css",
    "./tokens.css": "./dist/tokens.css",
    "./package.json": "./package.json",
    "./dark.css": "./dist/dark.css"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build:css": "tsx scripts/build-css.ts",
    "build:js": "tsup",
    "build": "npm run build:css && npm run build:js && npm run check:native && npm run build:compare && npm run build:skill",
    "typecheck": "tsc --noEmit",
    "preview": "npm run build && python3 -m http.server 4173 --directory .",
    "check:native": "tsx scripts/check-native.ts",
    "check": "npm run typecheck && npm run check:native && npm run check:visual",
    "build:compare": "tsx scripts/build-compare.ts",
    "build:skill": "tsx scripts/build-skill.ts",
    "clean": "rm -rf dist .turbo",
    "check:visual": "tsx scripts/check-visual.ts"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.73"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.7",
    "esbuild": "^0.28.2",
    "pixelmatch": "^7.2.0",
    "playwright": "1.58.2",
    "pngjs": "^7.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.2.8",
    "react-native": "^0.87.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@hairline/tokens": "workspace:*"
  }
}
